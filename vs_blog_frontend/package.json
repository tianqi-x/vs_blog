{
  "name": "vs-blog-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vue-tsc": "^3.1.1",
    "vitest": "^4.1.12"
  }
}